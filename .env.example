# Copy to .env and fill in. Never commit .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=         # optional: WhatsApp sender, default Twilio's sandbox +14155238886
FAMILY_PHONE=                # plays Suyog (Sandy's son), +1XXXXXXXXXX
NEIGHBOR_PHONE=              # plays Krit (the neighbor); comma-separate several neighbors
PSAP_STANDIN_PHONE=          # teammate's phone standing in for 911. Never a real 911 number.
PUBLIC_BASE_URL=             # tunnel URL for answers coming back, e.g. https://xyz.trycloudflare.com (docs/TWILIO.md)
MQTT_HOST=carebot.local
ANTHROPIC_API_KEY=           # Claude API key (console.anthropic.com): phrasing, understanding, 911 Q&A
